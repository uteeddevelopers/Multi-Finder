    "macOS 26 이상이 필요합니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires macOS 26 or later"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 26 以降が必要です"
          }
        },
