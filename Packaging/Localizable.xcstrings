    "같은 자리에 있지만 내용이 다름 — 어느 쪽이 최신인지 확인 필요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same location, different content — check which one is newer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ場所にあるが内容が異なります — どちらが新しいか確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 자리에 있지만 내용이 다름 — 어느 쪽이 최신인지 확인 필요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置相同但内容不同 — 请确认哪一个更新"
