{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-Finder",
  "version": "1.0.0",
  "identifier": "com.taeholim.multifinder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multi-Finder",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Taeho Lim",
    "copyright": "© 2026 Taeho Lim",
    "license": "GPL-3.0-only",
    "category": "Utility",
    "shortDescription": "Free file manager for messy folders",
    "longDescription": "Several folders in one list, duplicate files, folder compare, on-device AI categories and app leftovers. Nothing is deleted outright: files go to the Recycle Bin and Ctrl+Z undoes a whole action.",
    "homepage": "https://github.com/uteeddevelopers/Multi-Finder",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean", "Japanese", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
